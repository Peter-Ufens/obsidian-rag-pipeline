{
  "name": "Vault - RAG delta schedule (public template)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 8,10,12,14,16,18,20,22 * * *"
            }
          ]
        }
      },
      "id": "tpl-ragdelta-0001-schedule",
      "name": "Even hours 8-22",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.VAULT_BRIDGE_BASE_URL || 'http://host.docker.internal:39790') + '/health' }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "tpl-ragdelta-0002-health",
      "name": "Probe vault bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "tpl-ragdelta-cond-01",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "tpl-ragdelta-0003-if",
      "name": "Bridge up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.VAULT_BRIDGE_BASE_URL || 'http://host.docker.internal:39790') + '/run/rag-cursor-delta' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Vault-Bridge-Token",
              "value": "={{ $env.VAULT_BRIDGE_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "tpl-ragdelta-0004-post",
      "name": "POST rag-cursor-delta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, -80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tpl-ragdelta-set-ok-1",
              "name": "summary",
              "value": "={{ 'vault RAG delta OK | status=' + ($json.statusCode || 0) + ' | runId=' + (($json.body && $json.body.runId) || '?') + ' | ' + $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "tpl-ragdelta-set-ok-2",
              "name": "ok",
              "value": "={{ ($json.statusCode || 0) === 202 }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "tpl-ragdelta-0005-ok",
      "name": "Format OK",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1040, -80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tpl-ragdelta-set-fail-1",
              "name": "summary",
              "value": "={{ 'vault RAG delta SKIP | bridge down status=' + ($('Probe vault bridge').item.json.statusCode || 0) + ' | start host bridge first | ' + $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "tpl-ragdelta-set-fail-2",
              "name": "ok",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "tpl-ragdelta-0006-fail",
      "name": "Format bridge down",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [780, 120]
    }
  ],
  "connections": {
    "Even hours 8-22": {
      "main": [
        [
          {
            "node": "Probe vault bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe vault bridge": {
      "main": [
        [
          {
            "node": "Bridge up?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bridge up?": {
      "main": [
        [
          {
            "node": "POST rag-cursor-delta",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format bridge down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST rag-cursor-delta": {
      "main": [
        [
          {
            "node": "Format OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris"
  },
  "staticData": null,
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false,
    "note": "PUBLIC TEMPLATE. Even hours 8-22 (edit cron as needed). Soft-skip lives on the host script. Set VAULT_BRIDGE_* env vars. Keep inactive until bridge health is OK."
  },
  "tags": [
    "public-template",
    "vault",
    "rag",
    "schedule"
  ]
}
